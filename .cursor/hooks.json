{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/bmad-chain-before.js"
      },
      {
        "command": "node .cursor/hooks/bmad-chain-bmad-before.js"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/bmad-chain.js",
        "loop_limit": 10
      }
    ]
  }
}
