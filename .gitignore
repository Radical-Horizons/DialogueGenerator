# Windows specific files
desktop.ini
Thumbs.db
ehthumbs.db
*.lnk

# Python specific files
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
dist/
build/
*.so

# Python testing and coverage
.pytest_cache/
.coverage
coverage.xml
coverage.html
htmlcov/
*.cover
.hypothesis/
.mypy_cache/
.ruff_cache/

# Virtual environment
.env
.env.local
.env.production
.env.development
.venv
venv/
ENV/
env/
env.bak/
venv.bak/

# Node.js / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend build and cache
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/coverage/
*.tsbuildinfo
frontend/test-results/
test-results/
playwright-report/
playwright/.cache/
e2e/.auth/

# BMAD / Cursor — état éphémère chaîne AUTO (create-story auto → dev-story → code-review → 1)
.bmad-auto-chain.pending.json
.cursor/hooks/bmad-hook-last-run.json
.cursor/hooks/bmad-chain-debug.log

# Cursor IDE — plans et prefs machine (ne pas versionner)
# Note: `.cursor/hooks/` est versionné (scripts BMAD / chaîne Cursor) pour rester aligné avec hooks.json.
.cursor/plans/
.cursor/settings.json
.cursor/worktrees.json

# IDE specific files — ignorer le contenu des dossiers .vscode sauf extensions.json (recommandations partagées)
**/.vscode/*
!**/.vscode/extensions.json
.idea/
# VSCode Counter: auto-generated metrics (do not commit)
.VSCodeCounter/
.VSCodeCounter/**
*.suo
*.user

# macOS specific (often cross-platform)
.DS_Store

# Logs — racine (legacy / scripts) et logs applicatifs (JSON, .log, etc.)
/logs/
data/logs/
*.log

# Data directories (generated/cache files)
data/cost_budgets.json
data/llm_usage/
data/notion_cache/
data/gdd_notion_sync/notion_token.secret
# État / cache sync Notion (régénérable). settings.json / status.json versionnés si l’équipe les suit.
data/gdd_notion_sync/notion_search_snapshot.json
data/gdd_notion_sync/full_sync_checkpoint.json
data/gdd_notion_sync/full_sync_checkpoint.manifest.json

# Snapshot pickle GDD (cache local, régénéré si les JSON sources changent)
data/.gdd_snapshot/
data/.gdd_context_precompile/

# Historique d’entités GDD (persisté localement par gdd_entity_history)
data/GDD_entity_history/

# GDD_categories : versionner les fiches ; exclure uniquement backups / staging sync Notion
data/GDD_categories/.archive/
data/GDD_categories/.staging/
data/interactions/
# UnityData : tout ignorer sauf le catalogue flags versionné pour FR89 / pipeline mécaniques.
data/UnityData/*
!data/UnityData/FlagCatalog.csv

# Dialogue JSON (générés / sortie Unity)
Assets/Dialogue/*.json
# Layouts (positions nœuds, générés / locaux)
Assets/Layouts/*.layout.json
# Unity / éditeur meta
*.meta

# Temporary files
tmp/vitest-report.json
tmp/vitest-*.json
/vitest-*.txt
/pytest-*.txt
/measure-out.txt
*.tmp
*.bak
*.swp
test_prompt_output.txt

# User interface settings file
ui_settings.json
app_config.json

# Données locales et générées (fichiers JSON de logs uniquement, pas les configs)
# Note: data/config/*.json peut être versionné selon besoin

# Development lock files (machine-specific, transient state)
.dev/

# CI / test artefacts (generated by npm run test:ci)
tmp/
!tmp/.gitkeep
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml
