# Configuration JWT
# IMPORTANT: En production, utilisez une clé secrète forte générée aléatoirement
# Génération d'une clé sécurisée: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-change-in-production

# Rate Limiting (Endpoints d'authentification)
# Activer/désactiver le rate limiting sur /login et /refresh
AUTH_RATE_LIMIT_ENABLED=true
# Nombre de requêtes autorisées par fenêtre de temps
AUTH_RATE_LIMIT_REQUESTS=20
# Fenêtre de temps en secondes
AUTH_RATE_LIMIT_WINDOW=60

# Environment
# Valeurs possibles: development, production
ENVIRONMENT=development

# Authentification API
# false (recommandé) = JWT requis ; entrée UI en guest auto (POST /auth/guest)
# true = JWT ignoré, utilisateur mock admin (réservé pytest / Playwright E2E)
DISABLE_AUTH=false

# Clé API OpenAI (requise pour la génération de dialogues)
OPENAI_API_KEY=your-openai-api-key-here

# CORS / URL publique du frontend
# Développement : laissez vide — localhost + tunnels ngrok sont gérés par l'API.
# Production : une seule variable suffit (recommandé) :
#   PUBLIC_ORIGIN=https://demo.auto-diffusion.net
# (URL complète ou domaine seul ; plusieurs origines : CSV, ex. https://a.com,https://b.com)
# Option avancée : CORS_ORIGINS=... (CSV) — si défini, il remplace PUBLIC_ORIGIN pour CORS.
# CORS_ORIGINS=

# Logging
# Format: json ou text (default: text en dev, json en prod)
LOG_FORMAT=
# Niveau: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Métriques Prometheus
PROMETHEUS_ENABLED=true

# Health Check
# Ping LLM dans health check (peut être lent, désactivé par défaut)
HEALTH_CHECK_LLM_PING=false

# Démarrage plus rapide (development uniquement pour la validation)
# Saute validate_all_configs au startup (le GDD est toujours chargé). Ignoré si ENVIRONMENT=production.
# SKIP_STARTUP_CONTEXT_VALIDATION=true
# Saute le scan de nettoyage des vieux fichiers de log au démarrage
# SKIP_STARTUP_LOG_CLEANUP=true

# Retry & Circuit Breaker pour appels LLM
LLM_RETRY_ENABLED=true
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1.0

LLM_CIRCUIT_BREAKER_ENABLED=true
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_TIMEOUT=60

# Sentry (optionnel)
# DSN Sentry (vide = désactivé)
# SENTRY_ENVIRONMENT doit suivre ENVIRONMENT (development ici ; en prod: production)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Cache GDD
GDD_CACHE_ENABLED=true
GDD_CACHE_CHECK_INTERVAL=5
# Cache disque entre redémarrages (pickle sous data/.gdd_snapshot/, invalidé si un JSON source change)
# GDD_DISK_CACHE=false

# Cache HTTP
HTTP_CACHE_ENABLED=true
HTTP_CACHE_TTL_GDD=30
HTTP_CACHE_TTL_STATIC=300
HTTP_CACHE_MAX_SIZE=1000

# Pagination
PAGINATION_DEFAULT_PAGE_SIZE=50
PAGINATION_MAX_PAGE_SIZE=100
