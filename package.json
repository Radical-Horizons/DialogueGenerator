{
  "name": "dialogue-generator",
  "version": "1.8.3",
  "description": "DialogueGenerator - API REST FastAPI + Frontend React",
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-venv.ps1",
    "verify:venv": "powershell -ExecutionPolicy Bypass -File scripts/verify-venv.ps1",
    "dev": "node scripts/dev.js",
    "dev:timing": "node scripts/dev.js --timing",
    "dev:fast": "node scripts/dev.js --fast",
    "dev:clean": "node scripts/dev.js --clear-cache",
    "dev:back": "node scripts/dev.js --backend",
    "dev:front": "node scripts/dev.js --frontend",
    "dev:stop": "node scripts/dev.js --stop",
    "dev:status": "node scripts/dev-status.js",
    "dev:check": "node scripts/dev-check.js",
    "dev:debug": "node scripts/dev.js --debug",
    "dev:verbose": "node scripts/dev.js --verbose",
    "dev:quiet": "node scripts/dev.js --quiet",
    "config:snapshot": "node scripts/config-snapshot.js",
    "build": "cd frontend && npm install && npm run build",
    "version:sync": "node scripts/sync-app-version.js",
    "version:bump:patch": "npm version patch --no-git-tag-version && npm run version:sync",
    "version:bump:minor": "npm version minor --no-git-tag-version && npm run version:sync",
    "version:bump:major": "npm version major --no-git-tag-version && npm run version:sync",
    "release:commits-since-prod": "powershell -ExecutionPolicy Bypass -File scripts/list-commits-since-prod.ps1",
    "verify:app-version": "node scripts/verify-app-version.js",
    "build:check": "node scripts/verify-app-version.js && node scripts/check-build.js",
    "start": "node scripts/getPythonPath.js -m api.main",
    "test": "node scripts/getPythonPath.js -m pytest tests/",
    "test:backend:smoke": "node scripts/pytest-tier.cjs smoke",
    "test:backend:fast": "node scripts/pytest-tier.cjs fast",
    "test:backend:full": "node scripts/pytest-tier.cjs full",
    "test:smoke": "node scripts/pytest-tier.cjs smoke && cd frontend && npx vitest run --bail=1 --reporter=dot",
    "test:premerge": "node scripts/pytest-tier.cjs fast && npm --prefix frontend run lint && npm --prefix frontend test",
    "test:ci:local": "npm run test:backend:full && npm run test:frontend:vitest:full && npm run test:e2e:auth && npm run test:e2e:pwa",
    "test:e2e:smoke": "npx playwright test --grep \"@smoke\" --reporter=list --workers=1",
    "test:api": "node scripts/getPythonPath.js -m pytest tests/api/",
    "test:frontend": "powershell -ExecutionPolicy Bypass -File scripts/test-frontend.ps1",
    "test:frontend:quick": "cd frontend && npm run test:quick",
    "test:frontend:bail": "cd frontend && npm run test:bail",
    "test:frontend:vitest": "npm --prefix frontend run test:run:json",
    "test:frontend:vitest:full": "npm --prefix frontend run test:run:json:full",
    "test:frontend:vitest:summary": "node scripts/vitest-report-summary.js",
    "test:frontend:vitest:summary:full": "node scripts/vitest-report-summary.js tmp/vitest-report-full.json",
    "test:e2e": "playwright test",
    "test:e2e:verify": "node scripts/playwright-verify.cjs",
    "test:e2e:auth": "playwright test e2e/auth.spec.ts --project=chromium-auth-spec --reporter=list --workers=1",
    "test:e2e:pwa": "playwright test -c playwright.pwa.config.ts",
    "test:e2e:cost": "playwright test e2e/cost-governance.spec.ts --workers=1",
    "test:e2e:llm": "playwright test e2e/e2e-llm-preflight.spec.ts e2e/graph-node-accept-reject.spec.ts --workers=1",
    "test:e2e:llm:preflight": "playwright test e2e/e2e-llm-preflight.spec.ts --workers=1",
    "check:migration": "node scripts/check-choice-id-migration.js",
    "test:all": "node scripts/verify-app-version.js && node scripts/getPythonPath.js -m pytest tests/ && powershell -ExecutionPolicy Bypass -File scripts/test-frontend.ps1",
    "install:all": "powershell -ExecutionPolicy Bypass -File scripts/setup-venv.ps1 && cd frontend && npm install",
    "deploy:check": "powershell -ExecutionPolicy Bypass -File scripts/deploy_check.ps1",
    "deploy:build": "powershell -ExecutionPolicy Bypass -File scripts/build_production.ps1",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-production.ps1",
    "deploy:wsl": "wsl bash scripts/deploy-from-wsl.sh",
    "deploy:skip-build": "powershell -ExecutionPolicy Bypass -File scripts/deploy-production.ps1 -SkipBuild",
    "deploy:skip-restart": "powershell -ExecutionPolicy Bypass -File scripts/deploy-production.ps1 -SkipRestart",
    "diagnose:prod-context": "node scripts/getPythonPath.js scripts/diagnose_prod_context_validation.py",
    "start:prod": "powershell -ExecutionPolicy Bypass -File scripts/start-production.ps1",
    "start:debug": "powershell -ExecutionPolicy Bypass -File scripts/start-debug.ps1",
    "start:api": "powershell -ExecutionPolicy Bypass -Command \"$env:API_PORT='4243'; node scripts/getPythonPath.js -m api.main\"",
    "api:invoke": "powershell -ExecutionPolicy Bypass -File scripts/Invoke-DialogueApi.ps1",
    "generate:dialogue-tree": "node scripts/getPythonPath.js scripts/generate_dialogue_tree.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.0.3",
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "dialogue",
    "generator",
    "fastapi",
    "react",
    "llm"
  ],
  "author": "",
  "license": "ISC"
}
