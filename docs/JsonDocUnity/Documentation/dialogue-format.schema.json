{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://alteir.game/dialogue-format.schema.json",
  "title": "Alteir Dialogue JSON Format",
  "description": "Format JSON pour les dialogues du jeu Alteir. v1.2.0 : id = identifiant stable unique non éditable (préfixe node- ou manual- + alphanum/tirets/underscores). title = libellé éditable. Pseudo-nœud END : seule exception, nœud virtuel de fin ; si référencé (nextNode ou targetNode = \"END\"), il n'a pas besoin d'être présent dans nodes. FR94 (Story 9.6) : skillCheck, effortCost, reputation_fr94, reputation_delta_fr94, faction_title — aligné sur frontend/src/types et services/game_systems_*.py. Source canonique : docs/resources/ ; copie miroir docs/JsonDocUnity/Documentation/.",
  "version": "1.2.0",
  "type": "object",
  "required": ["schemaVersion", "nodes"],
  "definitions": {
    "VisibilityCombinator": {
      "type": "string",
      "enum": ["AND", "OR"],
      "description": "Combinaison logique entre les conditions atomiques du bloc."
    },
    "ComparisonOperator": {
      "type": "string",
      "enum": ["=", "!=", ">=", "<=", ">", "<"]
    },
    "VisibilityConditions": {
      "type": "object",
      "description": "Bloc de conditions de visibilité (Story 9.2) — AND/OR plat sur une liste d'atomes.",
      "required": ["combinator", "items"],
      "properties": {
        "combinator": { "$ref": "#/definitions/VisibilityCombinator" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/ConditionAtom" }
        }
      },
      "additionalProperties": false
    },
    "ConditionAtom": {
      "oneOf": [
        { "$ref": "#/definitions/FlagBoolCondition" },
        { "$ref": "#/definitions/FlagCounterCondition" },
        { "$ref": "#/definitions/FlagEnumCondition" },
        { "$ref": "#/definitions/ReputationCondition" },
        { "$ref": "#/definitions/ReputationConditionFr94" },
        { "$ref": "#/definitions/FactionTitleCondition" }
      ]
    },
    "FlagBoolCondition": {
      "type": "object",
      "required": ["kind", "flagId", "equals"],
      "properties": {
        "kind": { "const": "flag_bool" },
        "flagId": { "type": "string", "minLength": 1 },
        "equals": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "FlagCounterCondition": {
      "type": "object",
      "required": ["kind", "flagId", "operator", "value"],
      "properties": {
        "kind": { "const": "flag_counter" },
        "flagId": { "type": "string", "minLength": 1 },
        "operator": { "$ref": "#/definitions/ComparisonOperator" },
        "value": { "type": "number" }
      },
      "additionalProperties": false
    },
    "FlagEnumCondition": {
      "type": "object",
      "required": ["kind", "flagId", "operator", "value"],
      "properties": {
        "kind": { "const": "flag_enum" },
        "flagId": { "type": "string", "minLength": 1 },
        "operator": { "type": "string", "enum": ["=", "!="] },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ReputationCondition": {
      "type": "object",
      "required": ["kind", "axisId", "factionId", "operator", "threshold"],
      "properties": {
        "kind": { "const": "reputation" },
        "axisId": { "type": "string", "minLength": 1 },
        "factionId": { "type": "string", "minLength": 1 },
        "operator": { "$ref": "#/definitions/ComparisonOperator" },
        "threshold": { "type": "number" }
      },
      "additionalProperties": false
    },
    "ReputationAxisFr94": {
      "type": "string",
      "enum": ["Admiration", "Prestige", "Crainte"]
    },
    "ReputationTargetKindFr94": {
      "type": "string",
      "enum": ["heroine", "npc", "community"]
    },
    "ReputationReadModeFr94": {
      "type": "string",
      "enum": ["raw_npc", "final_npc", "community_calculated"]
    },
    "SocialTargetFr94": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "$ref": "#/definitions/ReputationTargetKindFr94" },
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ReputationConditionFr94": {
      "type": "object",
      "description": "Condition Réputation FR94 — cible sociale et mode de lecture explicites.",
      "required": ["kind", "heroineId", "target", "axis", "readMode", "operator", "threshold"],
      "properties": {
        "kind": { "const": "reputation_fr94" },
        "heroineId": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/definitions/SocialTargetFr94" },
        "axis": { "$ref": "#/definitions/ReputationAxisFr94" },
        "readMode": { "$ref": "#/definitions/ReputationReadModeFr94" },
        "operator": { "$ref": "#/definitions/ComparisonOperator" },
        "threshold": { "type": "number" }
      },
      "additionalProperties": false
    },
    "FactionTitleCondition": {
      "type": "object",
      "description": "Condition titre de faction — flag one-way ou catalogue titres.",
      "required": ["kind"],
      "properties": {
        "kind": { "const": "faction_title" },
        "flagId": { "type": "string", "minLength": 1 },
        "titleId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["flagId"] },
        { "required": ["titleId"] }
      ]
    },
    "SkillCheckIssue": {
      "type": "string",
      "enum": ["succès_critique", "succès", "échec", "échec_critique"]
    },
    "SkillCheckDefinition": {
      "type": "object",
      "description": "Test tentable caractéristique + compétence vs DD (FR94).",
      "required": ["attributeId", "skillId", "dc"],
      "properties": {
        "attributeId": { "type": "string", "minLength": 1 },
        "attributeLabel": { "type": "string" },
        "skillId": { "type": "string", "minLength": 1 },
        "skillLabel": { "type": "string" },
        "dc": { "type": "integer" },
        "modifier": { "type": "integer", "default": 0 },
        "branches": {
          "type": "object",
          "description": "Routage par issue vers targetNode.",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "CounterAdjustOperator": {
      "type": "string",
      "enum": ["=", "+=", "-="],
      "description": "Opérateurs d'effet sur compteur catalogue (Story 9.3)."
    },
    "ChoiceEffectAtom": {
      "oneOf": [
        { "$ref": "#/definitions/SetBoolEffect" },
        { "$ref": "#/definitions/AdjustCounterEffect" },
        { "$ref": "#/definitions/SetEnumEffect" },
        { "$ref": "#/definitions/ReputationDeltaEffect" },
        { "$ref": "#/definitions/ReputationDeltaEffectFr94" }
      ]
    },
    "SetBoolEffect": {
      "type": "object",
      "required": ["kind", "flagId", "value"],
      "properties": {
        "kind": { "const": "set_bool" },
        "flagId": { "type": "string", "minLength": 1 },
        "value": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "AdjustCounterEffect": {
      "type": "object",
      "required": ["kind", "flagId", "operator", "value"],
      "properties": {
        "kind": { "const": "adjust_counter" },
        "flagId": { "type": "string", "minLength": 1 },
        "operator": { "$ref": "#/definitions/CounterAdjustOperator" },
        "value": { "type": "number" }
      },
      "additionalProperties": false
    },
    "SetEnumEffect": {
      "type": "object",
      "required": ["kind", "flagId", "value"],
      "properties": {
        "kind": { "const": "set_enum" },
        "flagId": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ReputationDeltaEffect": {
      "type": "object",
      "required": ["kind", "axisId", "factionId", "delta"],
      "properties": {
        "kind": { "const": "reputation_delta" },
        "axisId": { "type": "string", "minLength": 1 },
        "factionId": { "type": "string", "minLength": 1 },
        "delta": { "type": "number" }
      },
      "additionalProperties": false
    },
    "ReputationDeltaEffectFr94": {
      "type": "object",
      "description": "Delta Réputation FR94 avec cible sociale explicite.",
      "required": ["kind", "heroineId", "target", "axis", "delta"],
      "properties": {
        "kind": { "const": "reputation_delta_fr94" },
        "heroineId": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/definitions/SocialTargetFr94" },
        "axis": { "$ref": "#/definitions/ReputationAxisFr94" },
        "delta": { "type": "number" }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.1.0", "1.2.0"],
      "description": "Version du schéma du document. 1.1.0 (legacy) ou 1.2.0 (id stable + title)."
    },
    "dialogueFlags": {
      "type": "array",
      "description": "Story 9.1 — liaisons catalogue flags et valeurs initiales pour ce fichier dialogue.",
      "items": {
        "type": "object",
        "required": ["flagId", "type", "initialValue"],
        "properties": {
          "flagId": { "type": "string" },
          "type": { "type": "string", "enum": ["bool", "compteur", "enum"] },
          "initialValue": {}
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "description": "Liste des nœuds du dialogue. Chaque nœud a un id unique et stable (non éditable). Le pseudo-nœud END peut être référencé sans être présent dans la liste.",
      "minItems": 1,
      "items": {
        "type": "object",
        "title": "Dialogue Node",
        "description": "Un nœud de dialogue. id = identifiant stable unique (toutes références) ; title = libellé affiché (éditable).",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifiant stable et unique du nœud, non éditable. Préfixe node- ou manual- (ex. node-abc123, manual-uuid). Exception : END pour le pseudo-nœud de fin.",
            "oneOf": [
              { "const": "END" },
              { "const": "START" },
              { "pattern": "^(node|manual)-[a-zA-Z0-9_-]+$" }
            ],
            "examples": ["node-start", "node-a1b2c3d4e5f6", "manual-a1b2c3d4-e5f6-7890-abcd-ef1234567890", "END"]
          },
          "visibilityConditions": {
            "$ref": "#/definitions/VisibilityConditions",
            "description": "Story 9.2 — conditions structurées d'affichage du nœud (prioritaire sur chaîne legacy si présent)."
          },
          "title": {
            "type": "string",
            "description": "Libellé affiché dans l'UI (carte nœud, jump-to, panneau). Éditable ; non utilisé pour les références."
          },
          "speaker": {
            "type": "string",
            "description": "ID du personnage qui parle (CHARACTER_ID). Optionnel mais recommandé.",
            "examples": ["NPC_1", "Player", "Narrator"]
          },
          "line": {
            "type": "string",
            "description": "Texte du dialogue à afficher. Optionnel mais recommandé.",
            "examples": ["Bonjour, voyageur !", "Que voulez-vous ?"]
          },
          "nextNode": {
            "type": "string",
            "description": "ID du nœud suivant (si pas de choix). Ignoré si choices est présent. Peut être END.",
            "examples": ["NEXT_NODE", "END"]
          },
          "choices": {
            "type": "array",
            "description": "Liste des choix disponibles pour ce nœud. Si présent, nextNode est ignoré. En mode cutscene (cutsceneMode: true), maximum 4 choix. Chaque choix doit avoir un choiceId stable (v1.1.0).",
            "minItems": 1,
            "items": {
              "type": "object",
              "title": "Dialogue Choice",
              "description": "Un choix disponible dans un nœud de dialogue. choiceId obligatoire (identité stable, v1.1.0).",
              "required": ["choiceId", "text", "targetNode"],
              "properties": {
                "choiceId": {
                  "type": "string",
                  "description": "Identifiant stable du choix (format libre). Obligatoire en v1.1.0. Utilisé pour les edges et la projection UI (ADR-008).",
                  "examples": ["choice_1", "accept", "refuse"]
                },
                "text": {
                  "type": "string",
                  "description": "Texte du choix affiché au joueur. Obligatoire.",
                  "examples": ["Accepter", "Refuser", "(Partir)"]
                },
                "targetNode": {
                  "type": "string",
                  "description": "ID du nœud cible lorsque ce choix est sélectionné. Obligatoire. Peut être END.",
                  "examples": ["ACCEPT", "REFUSE", "END"]
                },
                "traitRequirements": {
                  "type": "array",
                  "description": "Liste des exigences de traits pour débloquer ce choix. Optionnel.",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "title": "Trait Requirement",
                    "required": ["trait", "minValue"],
                    "properties": {
                      "trait": { "type": "string", "examples": ["Courageux", "Diplomate"] },
                      "minValue": { "type": "integer", "minimum": -100, "maximum": 100 }
                    }
                  }
                },
                "allowInfluenceForcing": { "type": "boolean", "default": false },
                "influenceThreshold": { "type": "integer", "default": 0, "minimum": 0 },
                "influenceDelta": { "type": "integer", "default": 0 },
                "respectDelta": { "type": "integer", "default": 0 },
                "test": {
                  "type": "string",
                  "pattern": "^[^\\s:+]+\\+[^\\s:+]+:\\d+$",
                  "examples": ["Raison+Logique:8", "Volonté+Adaptabilité:12"]
                },
                "testCriticalSuccessNode": { "type": "string", "examples": ["CHOICE_CRITICAL_SUCCESS", "NEXT"] },
                "testSuccessNode": { "type": "string", "examples": ["CHOICE_SUCCESS", "NEXT"] },
                "testFailureNode": { "type": "string", "examples": ["CHOICE_FAILURE", "FALLBACK"] },
                "testCriticalFailureNode": { "type": "string", "examples": ["CHOICE_CRITICAL_FAILURE", "FALLBACK"] },
                "condition": {
                  "type": "string",
                  "pattern": "^(NOT )?[A-Z][A-Z0-9_]*$",
                  "examples": ["FLAG_COMPLETED", "NOT FLAG_LOCKED"],
                  "description": "Legacy chaîne (Unity). Les nouvelles conditions utilisent visibilityConditions."
                },
                "visibilityConditions": {
                  "$ref": "#/definitions/VisibilityConditions",
                  "description": "Story 9.2 — conditions structurées sur ce choix."
                },
                "choiceEffects": {
                  "type": "array",
                  "description": "Story 9.3 — effets catalogue (flags + réputation) déclenchés à la sélection ; l'ordre dans le tableau est persisté.",
                  "items": { "$ref": "#/definitions/ChoiceEffectAtom" }
                },
                "effortCost": {
                  "type": "number",
                  "minimum": 0,
                  "description": "FR94 — coût en Points d'Effort (PE) ; grisé en preview si pool simulé insuffisant."
                },
                "skillCheck": {
                  "$ref": "#/definitions/SkillCheckDefinition",
                  "description": "FR94 — test tentable ; choix toujours visible, routage par issue."
                }
              }
            }
          },
          "test": {
            "type": "string",
            "pattern": "^[^\\s:+]+\\+[^\\s:+]+:\\d+$",
            "examples": ["Raison+Logique:8", "Volonté+Adaptabilité:12"]
          },
          "criticalSuccessNode": { "type": "string", "examples": ["TEST_CRITICAL_SUCCESS", "NEXT"] },
          "successNode": { "type": "string", "examples": ["TEST_SUCCESS", "NEXT"] },
          "failureNode": { "type": "string", "examples": ["TEST_FAILURE", "FALLBACK"] },
          "criticalFailureNode": { "type": "string", "examples": ["TEST_CRITICAL_FAILURE", "FALLBACK"] },
          "isLongRest": { "type": "boolean", "default": false },
          "startState": { "type": "integer", "default": 0, "minimum": 0 },
          "cutsceneMode": { "type": "boolean", "default": false },
          "cutsceneImageId": { "type": "string", "examples": ["scene_1", "portrait_npc"] },
          "cutsceneId": { "type": "string", "examples": ["cutscene_intro", "cutscene_ending"] },
          "exitCutsceneMode": { "type": "boolean", "default": false },
          "consequences": {
            "type": "object",
            "properties": {
              "flag": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "examples": ["CADRAN_EMPORTE", "QUEST_COMPLETED"] },
              "description": { "type": "string" }
            },
            "required": ["flag"]
          }
        },
        "allOf": [
          {
            "if": { "properties": { "cutsceneMode": { "const": true } } },
            "then": { "properties": { "choices": { "maxItems": 4 } } },
            "else": true
          }
        ]
      }
    }
  },
  "examples": [
    {
      "schemaVersion": "1.2.0",
      "nodes": [
        {
          "id": "node-start",
          "title": "Ouverture",
          "speaker": "Personnage",
          "line": "Bonjour !",
          "choices": [
            { "choiceId": "reply", "text": "Répondre", "targetNode": "node-reply" }
          ]
        },
        { "id": "node-reply", "line": "Suite..." }
      ]
    }
  ]
}
